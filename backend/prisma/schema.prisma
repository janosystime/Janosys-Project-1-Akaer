generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Perfil {
  ADMINISTRADOR
  USUARIO
  CHECKER
}

enum StatusSolicitacao {
  AGUARDANDO
  ANALISE
  ACEITA
  INDEFERIDA
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  login        String   @unique
  senha        String
  perfil       Perfil   @default(USUARIO)
  telefone     String?
  departamento String?
  dataCriacao  DateTime @default(now())

  @@map("usuarios")
}

model Norma {
  id            String   @id
  codigo        String?
  titulo        String
  organizacao   String
  categoria     String
  subcategoria  String?
  item          String?
  tipo          String   @default("Pública")
  revisao       String?
  status        String   @default("Vigente")
  notas         Json?
  referencias   Json?
  palavrasChave Json?
  nomePdf       String?
  urlPdf        String?      @db.MediumText
  imagens       Json?
  criadoPor     String?
  dataCriacao   DateTime @default(now())
  dataAlteracao DateTime @updatedAt

  pecas Peca[] @relation("NormasPecas")

  @@map("normas")
}

model VersaoNorma {
  id            Int      @id @default(autoincrement())
  normaId       String
  numero        Int
  codigo        String?
  titulo        String
  organizacao   String
  categoria     String
  subcategoria  String?
  item          String?
  tipo          String
  revisao       String?
  status        String
  notas         Json?
  referencias   Json?
  palavrasChave Json?
  nomePdf       String?
  urlPdf        String?  @db.MediumText
  imagens       Json?
  usuarioNome   String?
  evento        String
  data          DateTime @default(now())

  @@unique([normaId, numero])
  @@index([normaId])
  @@map("versoes_norma")
}

model Favorito {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  normaId     String
  dataCriacao DateTime @default(now())

  @@unique([usuarioId, normaId])
  @@index([usuarioId])
  @@map("favoritos")
}

model Peca {
  id           Int      @id @default(autoincrement())
  nome         String
  categoria    String
  subcategoria String
  dataCriacao  DateTime @default(now())

  normas Norma[] @relation("NormasPecas")

  @@map("pecas")
}

model Categoria {
  id            Int            @id @default(autoincrement())
  nome          String         @unique
  icone         String         @default("fa-folder")
  tema          String         @default("theme-cat-geral")
  padrao        Boolean        @default(false)
  dataCriacao   DateTime       @default(now())

  subcategorias Subcategoria[]

  @@map("categorias")
}

model Subcategoria {
  id          Int       @id @default(autoincrement())
  nome        String
  categoriaId Int
  dataCriacao DateTime  @default(now())

  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, nome])
  @@index([categoriaId])
  @@map("subcategorias")
}

model Solicitacao {
  id           Int               @id @default(autoincrement())
  codigo       String?
  titulo       String
  motivo       String?           @db.Text
  solicitante  String
  data         DateTime          @default(now())
  status       StatusSolicitacao @default(AGUARDANDO)
  motivoRecusa String?           @db.Text
  avaliador    String?

  @@map("solicitacoes")
}

model HistoricoAlteracao {
  id            Int      @id @default(autoincrement())
  normaId       String
  codigoNorma   String?
  tituloNorma   String
  usuarioNome   String
  tipoAlteracao String
  detalhes      String   @db.Text
  data          DateTime @default(now())

  @@map("historico_alteracoes")
}
