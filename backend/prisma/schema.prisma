generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Perfil {
  ADMINISTRADOR
  USUARIO
  CHECKER
}

enum StatusSolicitacao {
  AGUARDANDO
  ANALISE
  ACEITA
  INDEFERIDA
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  login        String   @unique
  senha        String
  perfil       Perfil   @default(USUARIO)
  telefone     String?
  departamento String?
  dataCriacao  DateTime @default(now())

  @@map("usuarios")
}

model Norma {
  id            String   @id
  codigo        String?
  titulo        String
  organizacao   String
  categoria     String
  subcategoria  String?
  item          String?
  tipo          String   @default("Pública")
  revisao       String?
  status        String   @default("Vigente")
  notas         Json?
  referencias   Json?
  palavrasChave Json?
  nomePdf       String?
  urlPdf        String?      @db.MediumText
  imagens       Json?
  criadoPor     String?
  dataCriacao   DateTime @default(now())
  dataAlteracao DateTime @updatedAt

  pecas Peca[] @relation("NormasPecas")

  @@map("normas")
}

// Snapshot completo de uma norma a cada criação/edição (versionamento).
// v1 nasce no cadastro; cada edição cria numero+1, preservando as anteriores.
model VersaoNorma {
  id            Int      @id @default(autoincrement())
  normaId       String
  numero        Int
  // snapshot dos campos da norma naquele momento
  codigo        String?
  titulo        String
  organizacao   String
  categoria     String
  subcategoria  String?
  item          String?
  tipo          String
  revisao       String?
  status        String
  notas         Json?
  referencias   Json?
  palavrasChave Json?
  nomePdf       String?
  urlPdf        String?  @db.MediumText
  imagens       Json?
  // metadados da versão
  usuarioNome   String?
  evento        String   // 'CADASTRO' | 'EDICAO'
  data          DateTime @default(now())

  @@unique([normaId, numero])
  @@index([normaId])
  @@map("versoes_norma")
}

// Favoritos: norma marcada por um usuário (N:N usuario <-> norma).
model Favorito {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  normaId     String
  dataCriacao DateTime @default(now())

  @@unique([usuarioId, normaId])
  @@index([usuarioId])
  @@map("favoritos")
}

model Peca {
  id           Int      @id @default(autoincrement())
  nome         String
  categoria    String
  subcategoria String
  dataCriacao  DateTime @default(now())

  normas Norma[] @relation("NormasPecas")

  @@map("pecas")
}

// Categoria raiz da Home (explorador de pastas). Antes hardcoded no frontend.
model Categoria {
  id            Int            @id @default(autoincrement())
  nome          String         @unique
  icone         String         @default("fa-folder")
  tema          String         @default("theme-cat-geral")
  // categorias padrão (Peça/Conjunto/Instalação/Geral) não podem ser excluídas
  padrao        Boolean        @default(false)
  dataCriacao   DateTime       @default(now())

  subcategorias Subcategoria[]

  @@map("categorias")
}

// Subcategoria (pasta) de uma categoria. Antes hardcoded/efêmera no frontend.
model Subcategoria {
  id          Int       @id @default(autoincrement())
  nome        String
  categoriaId Int
  dataCriacao DateTime  @default(now())

  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, nome])
  @@index([categoriaId])
  @@map("subcategorias")
}

model Solicitacao {
  id           Int               @id @default(autoincrement())
  codigo       String?
  titulo       String
  motivo       String?           @db.Text
  solicitante  String
  data         DateTime          @default(now())
  status       StatusSolicitacao @default(AGUARDANDO)
  motivoRecusa String?           @db.Text
  avaliador    String?

  @@map("solicitacoes")
}

model HistoricoAlteracao {
  id            Int      @id @default(autoincrement())
  normaId       String
  codigoNorma   String?
  tituloNorma   String
  usuarioNome   String
  tipoAlteracao String   // 'CADASTRO' | 'EDICAO' | 'EXCLUSAO'
  detalhes      String   @db.Text
  data          DateTime @default(now())

  @@map("historico_alteracoes")
}
