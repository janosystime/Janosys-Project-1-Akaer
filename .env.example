# Copie para .env e ajuste se precisar. NÃO versione o .env real.
# (As credenciais do banco estão fixas no docker-compose.yml para a entrega de
#  desenvolvimento: root / password / janosys_db.)

# Porta exposta no host (única necessária). Backend e RAG ficam internos.
FRONTEND_PORT=8095
# Usados só se você reabilitar as portas de debug no docker-compose.yml:
BACKEND_PORT=3001
RAG_PORT=8000

# Microserviço RAG
# Obrigatório para embeddings e geração via Hugging Face.
HF_TOKEN=hf_SEU_TOKEN_AQUI

# Pastas do host montadas no container do RAG.
# RAG_CHROMA_PATH deve apontar para o índice Chroma já gerado.
# RAG_DOCS_PATH deve apontar para a pasta com os PDFs usados/úteis para ingestão.
RAG_CHROMA_PATH=./RAG/chroma_data
RAG_DOCS_PATH=./RAG/documentos

# Origens permitidas caso o frontend chame o RAG diretamente.
# No Docker padrão, o acesso passa pelo Nginx em /rag-api e não depende de CORS.
RAG_CORS_ORIGINS=http://localhost:5173,http://localhost:8095
